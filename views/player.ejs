<!DOCTYPE html>
<html>
<head>
    <title>Player Information</title>
</head>
<body>  

    <h1><%= username%>'s Profile Page</h1>

    <ul>
        <li>ID: <%= id %></li>
        <li>Username: <%= username %></li>
        <li>Email: <%= email %></li>
        <li>Created At: <%= created_at %></li>
        <% scores.forEach(score => { %>
            <li><%= score.name %>, <%= score.score %></li>
        <% }); %>
        
    </ul>
</body>
</html>