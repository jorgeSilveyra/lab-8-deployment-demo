<!DOCTYPE html>
<html>
<head>
    <title>Player Directory</title>
</head>
<body>  
    <link rel="stylesheet" href="/css/players_styles.css">

    <h1>Player Directory</h1>

    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Created At</th>
        </tr>
        <% player_items.forEach(player_obj => { %>
            <tr>
                <th><%= player_obj.player_id %></th>
                <th><a href="/player/<%= player_obj.player_id %>"><%= player_obj.username %></a></a></th>
                <th><%= player_obj.email %></th>
                <th><%= player_obj.created_at %></th>
            </tr>
        <% }); %>
    </table>

    <a href="/create_player">Create New Player</a>
</body>
</html>
